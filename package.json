{
  "name": "coderocket-ui",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node tooling/build.mjs",
    "typecheck": "tsc6 --noEmit && vue-tsc --noEmit -p packages/vue/tsconfig.json",
    "test": "vitest run",
    "check": "node tooling/check-source-manifest.mjs && pnpm typecheck && pnpm build && pnpm test && pnpm smoke && pnpm clients:pack && pnpm clients:check",
    "legacy:build": "npm --prefix legacy/vue-tailwind-datepicker run build",
    "legacy:docs": "npm --prefix legacy/vue-tailwind-datepicker run docs:build",
    "smoke": "node tooling/smoke-distribution.mjs",
    "clients:pack": "node tooling/client-release.mjs",
    "clients:check": "node tooling/check-client-packages.mjs"
  },
  "devDependencies": {
    "@types/node": "22.20.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "esbuild": "0.28.2",
    "prettier": "3.9.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "npm:@typescript/typescript6@6.0.2",
    "vitest": "5.0.1",
    "@vitejs/plugin-vue": "6.0.9",
    "@vue/server-renderer": "3.5.43",
    "@vue/test-utils": "2.4.6",
    "jsdom": "30.1.0",
    "vite": "8.3.0",
    "vue": "3.5.43",
    "vue-tsc": "3.3.11"
  }
}
